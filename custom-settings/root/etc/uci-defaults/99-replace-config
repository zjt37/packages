#!/bin/sh

# 首次开机后替换 openclash 和 mosdns 配置文件

# 源文件位置（编译时打包到固件的位置）
SRC_DIR="/etc/uci-defaults"

# 目标目录
DEST_DIR="/etc/config"

# 替换 openclash 配置
if [ -f "${SRC_DIR}/openclash" ]; then
    cp -f "${SRC_DIR}/openclash" "${DEST_DIR}/openclash"
    echo "openclash 配置已替换"
fi

# 替换 mosdns 配置
if [ -f "${SRC_DIR}/mosdns" ]; then
    cp -f "${SRC_DIR}/mosdns" "${DEST_DIR}/mosdns"
    echo "mosdns 配置已替换"
fi

exit 0
