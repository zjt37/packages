#!/bin/sh

# 第一次开机综合脚本：设置网关、扩展overlay

# === 1. 设置网关和DNS ===
uci batch <<-EOF
	set network.lan.gateway='192.168.2.2'
	set network.lan.dns='127.0.0.1'
	commit network
	set dhcp.lan.ignore=1
	set dhcp.lan.dhcpv4='disabled'
	set dhcp.lan.dhcpv6='disabled'
	set dhcp.lan.ra='disabled'
	set dhcp.lan.ra_slaac='0'
	set dhcp.@dnsmasq[0].noresolv='1'
	set dhcp.@dnsmasq[0].port='5353'
	commit dhcp
EOF

# === 2. 扩展overlay分区 ===
DISK="/dev/sda"
[ -b "$DISK" ] || exit 0

# 当前 overlay 挂载设备(loop 挂镜像时是 /dev/loop0)
OVERLAY_DEV=$(mount | awk '$3=="/overlay" {print $1}')
case "$OVERLAY_DEV" in
    /dev/loop*) ;;
    /dev/sd*) exit 0 ;;
    /dev/vd*) exit 0 ;;
    *) exit 0 ;;
esac

# 尾部空闲区域(最后一段 Free)
FREE_START=$(parted -s "$DISK" unit s print free | awk '$4=="Free" {s=$1} END {gsub("s","",s); print s}')
FREE_END=$(parted -s "$DISK" unit s print free | awk '$4=="Free" {e=$2} END {gsub("s","",e); print e}')
[ -n "$FREE_START" ] || exit 0

FREE_SECTORS=$((FREE_END - FREE_START + 1))
[ "$FREE_SECTORS" -lt 2048 ] && exit 0

# 新建分区(占满剩余空间)
parted -s "$DISK" mkpart primary ext4 "${FREE_START}s" "${FREE_END}s"
sleep 2

# 找到新分区(最后一个分区号)
LAST_NUM=$(parted -s "$DISK" print | awk '/^ *[0-9]+ / {n=$1} END {print n}')
NEW_PART="${DISK}${LAST_NUM}"
[ -b "$NEW_PART" ] || exit 0

mkfs.ext4 -F -q -L rootfs_data "$NEW_PART"

# 拷贝 overlay 数据
mkdir -p /tmp/overlay_expand
mount "$NEW_PART" /tmp/overlay_expand
tar -C /overlay -cf - . | tar -C /tmp/overlay_expand -xf -
sync
umount /tmp/overlay_expand
rmdir /tmp/overlay_expand

# 关键：修改 fstab，把 /overlay 指到新分区
# (固件自带 overlay 镜像 label 也是 rootfs_data，不写 fstab 系统会优先挂 loop0)
NEW_UUID=$(blkid -s UUID -o value "$NEW_PART")
[ -n "$NEW_UUID" ] || exit 0

[ -f /etc/config/fstab ] || block detect > /etc/config/fstab

i=0
found=""
while uci get "fstab.@mount[$i]" >/dev/null 2>&1; do
	if [ "$(uci get "fstab.@mount[$i].target" 2>/dev/null)" = "/overlay" ]; then
		uci set "fstab.@mount[$i].uuid"="$NEW_UUID"
		uci set "fstab.@mount[$i].enabled"='1'
		found=1
		break
	fi
	i=$((i + 1))
done
if [ -z "$found" ]; then
	uci add fstab mount >/dev/null
	uci set "fstab.@mount[-1].uuid"="$NEW_UUID"
	uci set "fstab.@mount[-1].target"='/overlay'
	uci set "fstab.@mount[-1].enabled"='1'
fi
uci commit fstab
sync

reboot

exit 0