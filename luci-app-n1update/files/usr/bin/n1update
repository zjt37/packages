#!/bin/sh

REPO="zjt37/zheng"
API_URL="https://api.github.com/repos/${REPO}/releases/latest"
DOWNLOAD_DIR="/tmp/firmware"

get_release_info() {
    RELEASE_JSON=$(curl -s "${API_URL}")
    
    if [ -z "$RELEASE_JSON" ]; then
        echo "错误: 无法获取更新信息"
        return 1
    fi
    
    TAG_NAME=$(echo "$RELEASE_JSON" | jq -r '.tag_name')
    ASSET_URL=$(echo "$RELEASE_JSON" | jq -r '.assets[] | select(.name == "openwrt_n1.img") | .browser_download_url')
    FILE_SIZE=$(echo "$RELEASE_JSON" | jq -r '.assets[] | select(.name == "openwrt_n1.img") | .size')
    
    if [ -z "$ASSET_URL" ] || [ "$ASSET_URL" = "null" ]; then
        echo "错误: 未找到固件文件"
        return 1
    fi
    
    return 0
}

get_root_dev() {
    MOUNT_SRC=$(mount | grep ' / ' | awk '{print $1}')
    
    if echo "$MOUNT_SRC" | grep -q "overlayfs"; then
        ROOT_UUID=$(cat /proc/cmdline | tr ' ' '\n' | grep '^root=' | cut -d= -f2- | sed 's/PARTUUID=//;s/-[0-9]*$//')
        for dev in /dev/sd? /dev/vd? /dev/nvme?n?; do
            if [ -b "$dev" ] && blkid "$dev" 2>/dev/null | grep -qi "$ROOT_UUID"; then
                echo "$dev"
                return 0
            fi
        done
        echo "/dev/sda"
    else
        echo "$MOUNT_SRC" | sed 's/[0-9]*$//'
    fi
}

check_update() {
    echo "=== 检查更新 ==="
    echo "仓库: ${REPO}"
    echo ""
    
    get_release_info
    if [ $? -ne 0 ]; then return 1; fi
    
    FILE_SIZE_MB=$((FILE_SIZE / 1024 / 1024))
    
    if [ -f /etc/openwrt_release ]; then
        CURRENT_DATE=$(date -r /etc/openwrt_release +%Y-%m-%d 2>/dev/null)
    fi
    CURRENT_DATE=${CURRENT_DATE:-未知}
    
    NEW_DATE_RAW=$(echo "${TAG_NAME}" | cut -c9-16)
    if echo "$NEW_DATE_RAW" | grep -qE '^[0-9]{8}$'; then
        NEW_DATE=$(echo "$NEW_DATE_RAW" | cut -c1-4)-$(echo "$NEW_DATE_RAW" | cut -c5-6)-$(echo "$NEW_DATE_RAW" | cut -c7-8)
        NEW_TIME=$(echo "${TAG_NAME}" | cut -c17-22)
        NEW_TIME=$(echo "$NEW_TIME" | cut -c1-2):$(echo "$NEW_TIME" | cut -c3-4):$(echo "$NEW_TIME" | cut -c5-6)
        
        echo "当前固件: 构建于 ${CURRENT_DATE}"
        echo "最新固件: 构建于 ${NEW_DATE} ${NEW_TIME}"
        echo ""
        
        CUR=$(echo "$CURRENT_DATE" | tr -d '-')
        if echo "$CUR" | grep -qE '^[0-9]{8}$'; then
            if [ "$NEW_DATE_RAW" -gt "$CUR" ]; then
                echo "结果: 检测到新版本，可以开始更新！"
            elif [ "$NEW_DATE_RAW" -eq "$CUR" ]; then
                echo "结果: 最新固件与当前固件同日构建，可能无实质更新"
            else
                echo "结果: 当前固件已是最新版本"
            fi
        else
            if [ "$NEW_DATE_RAW" -gt "$(date +%Y%m%d)" ]; then
                echo "结果: 检测到新版本，可以开始更新！"
            else
                echo "结果: 已是最新版本"
            fi
        fi
    else
        echo "当前固件: 构建于 ${CURRENT_DATE}"
        echo "结果: 无法解析最新固件版本号，请手动核对"
    fi
    echo ""
    echo "最新版本: ${TAG_NAME}"
    echo "固件大小: ${FILE_SIZE_MB} MB"
    echo "下载地址: ${ASSET_URL}"
    echo ""
    echo "固件信息获取成功，可以开始更新"
}

download_firmware() {
    mkdir -p "${DOWNLOAD_DIR}"
    
    echo "正在下载固件..."
    rm -f "${DOWNLOAD_DIR}/openwrt_n1.img"
    curl -s -L -o "${DOWNLOAD_DIR}/openwrt_n1.img" "${ASSET_URL}" &
    CURL_PID=$!
    
    while kill -0 $CURL_PID 2>/dev/null; do
        sleep 3
        if [ -f "${DOWNLOAD_DIR}/openwrt_n1.img" ]; then
            CURRENT=$(ls -l "${DOWNLOAD_DIR}/openwrt_n1.img" 2>/dev/null | awk '{print $5}')
            CURRENT=${CURRENT:-0}
            if [ "$FILE_SIZE" -gt 0 ] 2>/dev/null; then
                PERCENT=$((CURRENT * 100 / FILE_SIZE))
                CURRENT_MB=$((CURRENT / 1024 / 1024))
                TOTAL_MB=$((FILE_SIZE / 1024 / 1024))
                printf "\r下载进度: %d%% (%d/%d MB)" "$PERCENT" "$CURRENT_MB" "$TOTAL_MB" > /tmp/n1update_progress
            fi
        fi
    done
    wait $CURL_PID
    CURL_STATUS=$?
    echo "" > /tmp/n1update_progress
    
    if [ $CURL_STATUS -ne 0 ]; then
        echo "错误: 下载失败"
        return 1
    fi
    
    echo "下载完成，校验文件..."
    DOWNLOADED_SIZE=$(stat -c%s "${DOWNLOAD_DIR}/openwrt_n1.img" 2>/dev/null || stat -f%z "${DOWNLOAD_DIR}/openwrt_n1.img" 2>/dev/null)
    
    if [ "$DOWNLOADED_SIZE" -ne "$FILE_SIZE" ]; then
        echo "错误: 文件大小不匹配 (期望: ${FILE_SIZE}, 实际: ${DOWNLOADED_SIZE})"
        return 1
    fi
    
    echo "文件校验通过"
    return 0
}

flash_with_amlogic() {
    local MODE="$1"
    local RESTORE="no-restore"
    
    if [ ! -x /usr/sbin/openwrt-update-amlogic ]; then
        echo "错误: 未找到 /usr/sbin/openwrt-update-amlogic，请使用 ophub 固件"
        return 1
    fi
    
    if [ "$MODE" = "keep" ]; then
        RESTORE="restore"
    fi
    
    echo "正在调用 ophub 更新引擎刷入（${MODE}），请勿断电..."
    echo ""
    /usr/sbin/openwrt-update-amlogic "${DOWNLOAD_DIR}/openwrt_n1.img" yes "${RESTORE}"
}

fresh_install() {
    echo "=== 全新安装 ==="
    
    get_release_info
    if [ $? -ne 0 ]; then return 1; fi
    
    download_firmware
    if [ $? -ne 0 ]; then return 1; fi
    
    flash_with_amlogic fresh
}

keep_settings() {
    echo "=== 保留配置更新 ==="
    
    get_release_info
    if [ $? -ne 0 ]; then return 1; fi
    
    download_firmware
    if [ $? -ne 0 ]; then return 1; fi
    
    flash_with_amlogic keep
}

case "$1" in
    check)
        check_update
        ;;
    fresh)
        fresh_install
        ;;
    keep)
        keep_settings
        ;;
    *)
        echo "用法: $0 {check|fresh|keep}"
        echo "  check  - 检查更新"
        echo "  fresh  - 全新安装（不保留配置）"
        echo "  keep   - 保留配置更新"
        ;;
esac
