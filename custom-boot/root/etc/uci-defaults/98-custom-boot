#!/bin/sh

# 第一次开机综合脚本：设置网关、DNS、DHCP、dnsmasq

uci -q batch <<-EOF
	set network.lan.gateway='192.168.1.1'
	set network.lan.dns='127.0.0.1'
	commit network
	set dhcp.lan.dhcpv6='disabled'
	set dhcp.lan.ra='disabled'
	set dhcp.lan.ra_slaac='0'
	set dhcp.@dnsmasq[0].port='5353'
	commit dhcp
EOF

# 开机自动挂载 emmc 分区（幂等，只注册一次）
if [ ! -f /usr/bin/mount-emmc.sh ]; then
	cat > /usr/bin/mount-emmc.sh <<'EMEOF'
#!/bin/sh
mkdir -p /mnt/mmcblk2p2 /mnt/mmcblk2p3 /mnt/mmcblk2p4
mount /dev/mmcblk2p1 /boot 2>/dev/null
rootdev=$(mount | awk '$3=="/" {print $1}')
case "$rootdev" in
*/mmcblk2p2) mount /dev/mmcblk2p3 /mnt/mmcblk2p3 2>/dev/null ;;
*/mmcblk2p3) mount /dev/mmcblk2p2 /mnt/mmcblk2p2 2>/dev/null ;;
esac
mount /dev/mmcblk2p4 /mnt/mmcblk2p4 2>/dev/null
exit 0
EMEOF
	chmod +x /usr/bin/mount-emmc.sh
	sed -i '/^exit 0/i /usr/bin/mount-emmc.sh' /etc/rc.local
fi
/usr/bin/mount-emmc.sh

exit 0